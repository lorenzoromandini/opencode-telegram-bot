# Token del bot Telegram (da BotFather). OBBLIGATORIO.
TELEGRAM_BOT_TOKEN=

# ID utente Telegram autorizzati, separati da virgola o spazio.
# Se vuoto, il bot rifiuta tutti ma risponde indicando il loro user ID: utile
# al primo avvio per scoprire il proprio ID e poi incollarlo qui.
# Esempio: 123456789,987654321
TELEGRAM_ALLOWED_USER_IDS=

# Permette a CHIUNQUE di usare il bot (NON consigliato). true/false
ALLOW_UNSAFE=false

# URL del server OpenCode. Se vuoto, il bot scopre/avvia il servizio in background.
# OPENCODE_SERVER_URL=http://127.0.0.1:49374

# Cartella di lavoro predefinita per le nuove sessioni e per /shell.
# Se vuota usa la cartella corrente del processo.
# OPENCODE_DEFAULT_WORKDIR=C:\Users\me\progetti

# Intervallo (ms) tra gli aggiornamenti progressivi del messaggio in streaming.
STREAM_EDIT_INTERVAL_MS=1500

# Livello di log: debug | info | warn | error
LOG_LEVEL=info
